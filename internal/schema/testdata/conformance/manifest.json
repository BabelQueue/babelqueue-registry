     "type": "integer",
     "minimum": 1
    },
    "amount": {
     "type": "number",
     "minimum": 0
    },
    "currency": {
     "enum": [
      "USD",
      "EUR",
      "TRY"
     ]
    }
   },
   "additionalProperties": false
  },
